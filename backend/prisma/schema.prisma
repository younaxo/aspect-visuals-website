generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(cuid())
  discordId              String?             @unique
  username               String
  discriminator          String?
  avatar                 String?
  banner                 String?
  bio                    String?
  location               String?
  website                String?
  customStatus           String?
  status                 String              @default("online")
  email                  String?             @unique
  password               String?
  isEmailVerified        Boolean             @default(false)
  discordLinked          Boolean             @default(false)
  telegramId             String?             @unique
  telegramLinked         Boolean             @default(false)
  discordLinkToken       String?
  resetToken             String?
  resetTokenExpiry       DateTime?
  discordAccessToken     String?
  discordRefreshToken    String?
  roles                  Role[]
  sessions               Session[]
  settings               UserSettings?
  passwordResets         PasswordReset[]
  emailVerifications     EmailVerification[]
  purchases              Purchase[]
  userSubscriptions      UserSubscription[]
  promoUsed              PromoCodeUsed[]
  activationKeys         ActivationKey[]
  bonusUsed              BonusCodeUsed[]
  messages               Message[]
  messageReactions       MessageReaction[]
  chatPresence           ChatUser?
  lastTestSubscriptionAt DateTime?
  lastDailyBonusAt       DateTime?
  balance                Decimal             @default(0)
  balanceTransactions    BalanceTransaction[]
  deletedAt              DateTime?
  isDeleted              Boolean             @default(false)
  adminLogs              AdminLog[]
  ban                    Ban?
  bansIssued             Ban[]               @relation("BannedBy")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model Subscription {
  id                String             @id @default(cuid())
  name              String
  description       String?
  price             Decimal
  duration          Int
  type              String
  discordRoleId     String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  purchases         Purchase[]
  userSubs          UserSubscription[]
  activationKeys    ActivationKey[]
  activationBatches ActivationBatch[]
}

model Product {
  id                String            @id @default(cuid())
  name              String
  description       String?
  price             Decimal
  type              String
  giftable          Boolean           @default(true)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  purchases         Purchase[]
  activationKeys    ActivationKey[]
  activationBatches ActivationBatch[]
}

model CodeFolder {
  id              String           @id @default(cuid())
  name            String
  kind            String
  createdAt       DateTime         @default(now())
  promoCodes      PromoCode[]
  bonusCodes      BonusCode[]
  activationKeys  ActivationKey[]
}

model PromoCode {
  id               String          @id @default(cuid())
  code             String          @unique
  type             String
  value            Decimal         @default(0)
  minOrderAmount   Decimal?        @default(0)
  subscriptionType String?
  durationDays     Int?
  note             String?
  folderId         String?
  folder           CodeFolder?     @relation(fields: [folderId], references: [id])
  validFrom        DateTime        @default(now())
  validUntil       DateTime?
  maxUses          Int             @default(1)
  usedCount        Int             @default(0)
  oncePerUser      Boolean         @default(true)
  isActive         Boolean         @default(true)
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  usedBy           PromoCodeUsed[]
  purchases        Purchase[]
}

model BonusCode {
  id               String          @id @default(cuid())
  code             String          @unique
  days             Int             @default(0)
  amount           Decimal         @default(0)
  subscriptionType String          @default("BALANCE")
  note             String?
  folderId         String?
  folder           CodeFolder?     @relation(fields: [folderId], references: [id])
  maxUses          Int             @default(1)
  usedCount        Int             @default(0)
  oncePerUser      Boolean         @default(true)
  isActive         Boolean         @default(true)
  validUntil       DateTime?
  createdBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  usedBy           BonusCodeUsed[]
}

model BonusCodeUsed {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  bonusCodeId String
  bonusCode   BonusCode @relation(fields: [bonusCodeId], references: [id])
  usedAt      DateTime  @default(now())

  @@index([userId])
  @@index([bonusCodeId])
}

model Message {
  id        String            @id @default(cuid())
  content   String
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  channel   String            @default("general")
  parentId  String?
  parent    Message?          @relation("MessageReplies", fields: [parentId], references: [id])
  replies   Message[]         @relation("MessageReplies")
  isPinned  Boolean           @default(false)
  isEdited  Boolean           @default(false)
  isDeleted Boolean           @default(false)
  editedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  reactions MessageReaction[]

  @@index([channel, createdAt])
  @@index([parentId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

model ChatUser {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  lastSeen      DateTime @default(now())
  isOnline      Boolean  @default(false)
  typing        Boolean  @default(false)
  mutedChannels String[]
  lastRead      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PromoCodeUsed {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  purchaseId  String?
  usedAt      DateTime  @default(now())

  @@index([userId])
  @@index([promoCodeId])
}

model ActivationKey {
  id             String            @id @default(cuid())
  key            String            @unique
  productId      String?
  product        Product?          @relation(fields: [productId], references: [id])
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id])
  generatedBy    String?
  activatedBy    User?             @relation(fields: [activatedById], references: [id])
  activatedById  String?
  usedAt         DateTime?
  expiresAt      DateTime?
  durationDays   Int?
  isUsed         Boolean           @default(false)
  note           String?
  folderId       String?
  folder         CodeFolder?       @relation(fields: [folderId], references: [id])
  batchId        String?
  batch          ActivationBatch?  @relation(fields: [batchId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([batchId])
  @@index([isUsed])
}

model ActivationBatch {
  id             String         @id @default(cuid())
  name           String
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  count          Int
  keys           ActivationKey[]
  generatedBy    String?
  createdAt      DateTime       @default(now())
}

model Purchase {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  productId      String?
  product        Product?       @relation(fields: [productId], references: [id])
  amount         Decimal
  status         String
  paymentId      String?
  paymentMethod  String?
  orderId        String?
  giftToUserId   String?
  promoCodeId    String?
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id])
  createdAt      DateTime       @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
}

model UserSubscription {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  startDate      DateTime     @default(now())
  endDate        DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
}

// Журнал операций с балансом: ежедневный бонус, бонус-коды, покупки, возвраты
model BalanceTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal
  kind      String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind])
}

model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          String   @default("dark")
  notifications  Boolean  @default(true)
  soundEnabled   Boolean  @default(true)
  compactSidebar Boolean  @default(false)
  animations     Boolean  @default(true)
  language       String   @default("ru")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id        String   @id @default(cuid())
  discordId String   @unique
  name      String
  users     User[]
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
}

model Ban {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  bannedBy    String
  admin       User      @relation("BannedBy", fields: [bannedBy], references: [id])
  reason      String?
  expiresAt   DateTime?
  isPermanent Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}
